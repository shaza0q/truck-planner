# ==========================================
# Backend Configuration (.env in /backend)
# ==========================================
SECRET_KEY=your-production-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,*.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Routing / Geocoding Service Configuration
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_USER_AGENT=SpotterTripPlanner/1.0 (contact: admin@spotterplanner.local)
MAP_REQUEST_TIMEOUT_SECONDS=10
NOMINATIM_REQUEST_DELAY_SECONDS=1.0

# ==========================================
# Frontend Configuration (.env in /frontend)
# ==========================================
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
